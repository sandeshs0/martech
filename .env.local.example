# Copy to .env.local and fill in real keys.

# Groq — LLM inference for all 5 agents. https://console.groq.com/keys
GROQ_API_KEY=

# Tavily — web search for the Research Agent. https://app.tavily.com
TAVILY_API_KEY=

# --- Image generation -------------------------------------------------------
# Three interchangeable providers. The first one with a key set wins, in this
# order: Gemini, Together, Fal. Set IMAGE_PROVIDER to force a specific one.

# Google Gemini. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override if Google renames the model (default: gemini-2.5-flash-image)
GEMINI_IMAGE_MODEL=

# Together.ai — FLUX.1 [schnell] free endpoint. https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=

# Fal.ai — FLUX.1 [schnell]. Requires account credit; no free tier.
# https://fal.ai/dashboard/keys
FAL_KEY=

# Optional: "gemini" | "together" | "fal"
IMAGE_PROVIDER=
